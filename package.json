{
  "name": "voxel-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "projects/voxel-village",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @visual/voxel-village",
    "build": "npm run build --workspace @visual/voxel-village",
    "preview": "npm run preview --workspace @visual/voxel-village",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
